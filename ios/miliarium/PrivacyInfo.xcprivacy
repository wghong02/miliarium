<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- Miliarium does not track users across apps/websites owned by other
	     companies, and contacts no tracking domains. -->
	<key>NSPrivacyTracking</key>
	<false/>
	<key>NSPrivacyTrackingDomains</key>
	<array/>

	<!-- App-level data-collection declarations are managed in App Store Connect's
	     privacy questionnaire; bundled SDKs (Firebase) ship their own manifests. -->
	<key>NSPrivacyCollectedDataTypes</key>
	<array/>

	<!-- Required-reason API usage (Apple's "ITMS-91053" requirement). -->
	<key>NSPrivacyAccessedAPITypes</key>
	<array>
		<dict>
			<!-- FileManager.attributesOfItem(atPath:) — read the size of a
			     picked video before upload (MediaService.uploadVideo). -->
			<key>NSPrivacyAccessedAPIType</key>
			<string>NSPrivacyAccessedAPICategoryFileTimestamp</string>
			<key>NSPrivacyAccessedAPITypeReasons</key>
			<array>
				<string>C617.1</string>
			</array>
		</dict>
		<dict>
			<!-- UserDefaults — onboarding flags and the app-group snapshot store
			     shared with the Miliarium widget (OnboardingState,
			     WidgetSnapshotStore). Accessible only to our own app/extension. -->
			<key>NSPrivacyAccessedAPIType</key>
			<string>NSPrivacyAccessedAPICategoryUserDefaults</string>
			<key>NSPrivacyAccessedAPITypeReasons</key>
			<array>
				<string>CA92.1</string>
			</array>
		</dict>
	</array>
</dict>
</plist>
